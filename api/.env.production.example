# Production environment — NEVER commit real values
NODE_ENV=production
PORT=4000

# Database — hosted PostgreSQL (Neon, Supabase, etc.)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Or use a single connection string:
# DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend (production URL)
FRONTEND_URL=

# Email (M5 — transactional emails)
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=

# Stripe (M4)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
