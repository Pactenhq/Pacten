# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pacten
DB_PASSWORD=choose-a-password
DB_NAME=pacten

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Frontend (used for CORS) ---
FRONTEND_URL=http://localhost:3000

# --- M4: Stripe (Connect) ---
# Test mode during development (per client). Until the client's invite/keys
# arrive, keep the placeholder — the API runs in DEMO mode and simulates
# payments end-to-end. Swap in the real sk_test_* key: no code change needed.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

# --- M4: Contracts ---
# Final legal wording comes from the client; until then the built-in
# placeholder is used. Set this to override without a code change.
CONTRACT_LEGAL_WORDING=

# --- M5: Transactional emails (Resend) ---
# Client-owned Resend account required. Until RESEND_API_KEY is set, emails
# run in log-only mode (flows still work, nothing is sent).
# Requires the sending domain verified in Resend (pacten.info — verified Oct 29, 2026).
RESEND_API_KEY=
EMAIL_FROM=Pacten <hello@pacten.info>

# --- M4: Platform admin bootstrap (one-time) ---
# The platform admin account cannot be created via public signup (the admin
# role is rejected there) and the demo admin only seeds outside production.
# To create the real admin: set ADMIN_EMAIL + ADMIN_PASSWORD, boot the API
# once, verify the admin login, then REMOVE ADMIN_PASSWORD. The bootstrap
# runs only when no user with that email exists; it never changes an
# existing account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
